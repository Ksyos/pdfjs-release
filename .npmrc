# pnpm reads ONLY auth and registry settings from .npmrc. Every other pnpm
# setting (nodeLinker, allowBuilds, overrides, ...) lives in pnpm-workspace.yaml.
#
# Registry for @ksyos scoped packages (GitHub Packages).
#
# The auth token is intentionally NOT stored here. A committed .npmrc must never
# contain a secret, and pnpm refuses to expand ${ENV} placeholders in credentials
# read from a project .npmrc anyway. Provide the token via a trusted source:
#   - Local dev:      put `//npm.pkg.github.com/:_authToken=<token>` in your
#                     user-level ~/.npmrc (see README). The PAT needs the
#                     read:packages scope and must be SAML-SSO authorized for Ksyos.
#   - GitHub Actions: actions/setup-node with registry-url writes a user-level
#                     .npmrc from the NODE_AUTH_TOKEN secret.
@ksyos:registry=https://npm.pkg.github.com/
